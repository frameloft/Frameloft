{
  "name": "frameloft",
  "version": "2.1.1",
  "description": "Frameloft – a lightweight, open-source photo browser and digital asset manager",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "fetch-exiftool": "node scripts/fetch-exiftool.mjs",
    "app": "tauri dev",
    "dist": "tauri build",
    "test": "vitest run",
    "verify:rules": "node scripts/verify-repo-rules.mjs",
    "verify": "npm run verify:rules && npm run check && npm test && npm run build && cd src-tauri && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
